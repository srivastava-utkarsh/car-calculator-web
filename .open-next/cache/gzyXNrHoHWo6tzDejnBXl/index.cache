-translate-y-1/2 font-semibold text-white/70 z-10\">₹</span><input type=\"text\" required=\"\" class=\"w-full pl-8 pr-4 py-1.5 max-md:py-3 rounded-md focus:outline-none focus:ring-2 focus:ring-cyan-400 focus:border-transparent transition-all text-sm max-md:text-base bg-white/10 backdrop-blur-md border border-white/20 text-white placeholder-white/50 max-md:min-h-[48px]\" placeholder=\"Enter down payment\" value=\"\"/></div><div><div class=\"relative group\"><input type=\"range\" min=\"0\" max=\"0\" step=\"1000\" class=\"w-full h-0.5 rounded-full appearance-none cursor-pointer slider-enhanced transition-all duration-200 dark-theme\" style=\"background:linear-gradient(to right, #f97316 0%, #f97316 NaN%, rgba(255,255,255,0.2) NaN%, rgba(255,255,255,0.2) 100%)\" value=\"0\"/></div><div class=\"flex justify-between text-xs mt-1 text-white/60\"><span>₹0</span><span>₹<!-- -->0<!-- -->L</span></div></div></div></div><div class=\"flex items-center space-x-3 mb-3\"><h4 class=\"text-lg font-semibold text-blue-400\">Loan Details</h4><div class=\"h-px w-16 bg-white/30\"></div></div><div class=\"grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-6 relative\"><div class=\"space-y-2\"><div class=\"flex items-center justify-between mb-2\"><label class=\"text-sm font-medium text-white\" style=\"line-height:1.5\">Loan Tenure</label></div><div class=\"space-y-2\"><div class=\"relative group\"><input type=\"range\" min=\"1\" max=\"7\" step=\"0.01\" class=\"w-full h-0.5 rounded-full appearance-none cursor-pointer slider-enhanced transition-all duration-200 dark-theme\" style=\"background:linear-gradient(to right, #06b6d4 0%, #06b6d4 0%, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0.2) 100%)\" value=\"1\"/></div><div class=\"flex justify-between text-xs text-white/60\"><span>1yr</span><span>3yr</span><span>5yr</span><span>7yr</span></div></div></div><div class=\"hidden lg:block absolute left-1/2 transform -translate-x-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-transparent via-white/20 to-transparent\"></div><div class=\"space-y-2\"><div class=\"flex items-center justify-between mb-2\"><label class=\"text-sm font-medium text-white\" style=\"line-height:1.5\">Interest Rate</label><span class=\"text-sm font-bold text-cyan-300\">8<!-- -->% per annum</span></div><div class=\"space-y-2\"><div class=\"relative group\"><div class=\"relative\"><input type=\"range\" min=\"5\" max=\"15\" step=\"0.1\" class=\"w-full h-0.5 rounded-full appearance-none cursor-pointer slider-enhanced transition-all duration-200 dark-theme\" style=\"background:linear-gradient(to right, #06b6d4 0%, #06b6d4 30%, rgba(255,255,255,0.2) 30%, rgba(255,255,255,0.2) 100%)\" value=\"8\"/></div><div class=\"flex justify-between text-xs mt-1 text-white/60\"><span>5%</span><span>10%</span><span>15%</span></div></div></div></div></div></div></div><div class=\"space-y-10\"><div class=\"space-y-8\"><div class=\"flex items-center space-x-3 mb-3\"><h4 class=\"text-lg font-semibold text-blue-400\">Monthly Income</h4><div class=\"h-px w-16 bg-white/30\"></div></div><div class=\"space-y-2 p-2.5 rounded-lg transition-all duration-300 \"><div class=\"relative\"><span class=\"absolute left-4 top-1/2 transform -translate-y-1/2 font-semibold text-white/70 z-10\">₹</span><input type=\"text\" inputMode=\"numeric\" pattern=\"[0-9,]*\" autoComplete=\"off\" required=\"\" placeholder=\"Enter your monthly income\" class=\"w-full pl-8 pr-4 py-1.5 max-md:py-3 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-transparent transition-all text-sm max-md:text-base bg-white/10 backdrop-blur-md border text-white placeholder-white/50 max-md:min-h-[48px] touch-manipulation border-white/20\" style=\"-webkit-appearance:none;-webkit-tap-highlight-color:transparent\" value=\"\"/></div><p class=\"text-sm flex items-center mt-3 text-white/70\"><span class=\"w-1.5 h-1.5 bg-emerald-400 rounded-full mr-3\"></span>Used to calculate the 10% rule: total car expenses should not exceed 10% of your income</p></div>